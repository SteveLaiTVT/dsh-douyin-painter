{
  "name": "dsh-douyin-painter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "npm run build",
    "prebuild": "node scripts/clean.mjs",
    "start": "npm run build && node dist/scripts/start.js",
    "dev": "npm run build && node --watch dist/scripts/start.js",
    "test": "npm run build && node dist/scripts/test.js",
    "check": "npm run build",
    "setup:capture": "npm run build && node dist/scripts/setup-capture.js",
    "test:browser": "npm run build && node dist/scripts/test.js --browser",
    "setup:references": "npm run build && node dist/scripts/setup-references.js",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && node dist/scripts/build-assets.js"
  },
  "exports": {
    ".": "./dist/src/plugin.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist/",
    "public/",
    "src/",
    "web/",
    "scripts/",
    "tests/",
    "capture/",
    "assets/",
    "docs/",
    "tsconfig.json",
    "tsconfig.web.json",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    ".env.example"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/omggif": "^1.0.5",
    "playwright": "1.62.1",
    "typescript": "^5.9.3",
    "omggif": "1.0.10"
  },
  "description": "本机每日主题绘画大赛：弹幕、DeepSeek互动、GPT Image与MiniMax语音",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "dependencies": {
    "@livliv-dev/player": "0.3.0",
    "@stevelife/ai-kit": "git+https://cnb.cool/stevelife524/lib/ai-kit.git#055c4309b36e40029730d407130b5721ea9c642d",
    "@stevelife/speech-generation": "git+https://cnb.cool/stevelife524/lib/speech-generation.git#b250cf6466743cf1cd1c396b5276c6954086f697",
    "@stevelife/image-generation": "git+https://cnb.cool/stevelife524/lib/image-generation.git#5c199095b30c058114162c7907487331ad67309c"
  }
}
