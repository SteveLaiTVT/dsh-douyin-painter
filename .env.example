# 复制为 .env.local 后填写；环境变量优先。只在服务端读取，不发送到浏览器。
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
MINIMAX_API_KEY=
# DeepSeek 关闭思考，模型名可按账号权限调整。
DEEPSEEK_MODEL=deepseek-flash
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare
PAINTER_OUTPUT_FORMAT=gif
MINIMAX_SPEECH_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ID=Chinese (Mandarin)_Radio_Host
# 通常无需修改下面这些配置。
PAINTER_PORT=3210
# PAINTER_DATA_DIR=.data
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# MINIMAX_BASE_URL=https://api.minimax.cn/v1
# 仅抖音明确要求登录态时配置；本机免登录不替代上游验证。
# DOUYIN_COOKIE=
