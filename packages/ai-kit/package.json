{
  "name": "@stevelife/ai-kit",
  "version": "0.1.0",
  "type": "module",
  "description": "Reusable Node AI transport, images, speech synthesis and transcription",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.tests.json && node --test test-dist/tests/*.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "omggif": "1.0.10"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0",
    "@types/omggif": "^1.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://cnb.cool/stevelife524/bloomstage/ai-kit.git"
  }
}
