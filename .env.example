# All secrets are supplied by the broadcaster on the Mac. Never commit .env.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
# No default: empty/invalid/nonpositive disables ALL project paid requests.
show_budget_limit_usd=
DOUYIN_ROOM_KEY=
DOUYIN_TRANSPORT=ws
# Optional upstream configuration; this plugin never extracts browser cookies.
DOUYIN_COOKIE=
PAINTER_RUNTIME_ROOT=
PAINTER_SHOW_ID=
PAINTER_TEXT_PROVIDER=
PAINTER_TEXT_MODEL=
PAINTER_STILL_MODEL=gpt-image-2.6-flare
PAINTER_GIF_MODEL=
# Endpoint/model/project must match the broadcaster's verified combination.
PAINTER_GIF_ENDPOINT=
PAINTER_VERIFIED_IMAGE_PATHS=
# JSON pricing rules (exact parameter hash -> conservative upper bound + evidence).
# Empty rules prohibit paid requests; 0.025 is NEVER a bound.
PAINTER_COST_RULES=
# Enable only after Mac host isolation proof; default manual.
PAINTER_TOOL_ISOLATION_VERIFIED=false
PAINTER_HOST_SHA=
PAINTER_HOST_PERSISTENCE_PATH=
PAINTER_HOST_RETENTION_POLICY=
