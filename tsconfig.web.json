{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "public",
    "rootDir": "web",
    "types": [],
    "noImplicitAny": false,
    "noEmitOnError": true
  },
  "include": [
    "web/**/*.ts"
  ]
}
